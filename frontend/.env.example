# API設定
VITE_API_BASE_URL=http://localhost:8080

# Cognito認証設定
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/login/callback

# 本番環境の例：
# VITE_API_BASE_URL=https://api.bestyle.example.com
# VITE_COGNITO_REDIRECT_URI=https://bestyle.example.com/login/callback
