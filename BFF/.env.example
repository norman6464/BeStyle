# ============================================
# BFF Service - 環境変数設定テンプレート
# ============================================
# このファイルを .env にコピーして、実際の値を設定してください
# cp .env.example .env
# ============================================

# AWS IAM認証情報
AWS_ACCESS_KEY=your-aws-access-key-here
AWS_SECRET_KEY=your-aws-secret-key-here
AWS_REGION=ap-northeast-1

# Cognito User Pool設定
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret

# Cognito エンドポイント
COGNITO_DOMAIN=your-domain.auth.ap-northeast-1.amazoncognito.com
COGNITO_TOKEN_URI=https://your-domain.auth.ap-northeast-1.amazoncognito.com/oauth2/token
COGNITO_JWK_SET_URI=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_XXXXXXXXX/.well-known/jwks.json

# リダイレクトURI（フロントエンドのコールバック先）
COGNITO_REDIRECT_URI=http://localhost:5173/login/callback

# データベース設定
DB_URL=jdbc:mysql://localhost:3306/bff_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Tokyo&characterEncoding=UTF-8
DB_USERNAME=bestyle
DB_PASSWORD=bestyle123

# セッション設定
SESSION_COOKIE_NAME=BESTYLE_SESSION
SESSION_EXPIRY_HOURS=24
